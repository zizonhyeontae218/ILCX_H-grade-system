{
  "version": "1.1.0",
  "name": "ILCX H-grade",
  "scoring_mode": "binary_per_category",
  "partial_credit_allowed": false,
  "maximum_total": 100,
  "categories": [
    {"id":"idea_draft","label":"Idea draft","allowed_scores":[0,10]},
    {"id":"concept_development","label":"Concept development","allowed_scores":[0,10]},
    {"id":"implementation_skeleton","label":"Implementation skeleton","allowed_scores":[0,10]},
    {"id":"design_idea","label":"Design idea","allowed_scores":[0,10]},
    {"id":"design_realization","label":"Design realization","allowed_scores":[0,10]},
    {"id":"experience_realization","label":"Experience realization","allowed_scores":[0,10]},
    {"id":"compatibility_check","label":"Compatibility check","allowed_scores":[0,5]},
    {"id":"functional_testing","label":"Functional testing","allowed_scores":[0,5]},
    {"id":"promotion","label":"Promotion","allowed_scores":[0,15],"special_rule":"15 only if no AI intervention in promotional image/video/audio/hologram media; no promotion may receive 15; otherwise 0."},
    {"id":"optimization","label":"Optimization","allowed_scores":[0,15]}
  ],
  "decision_rule": "Award the full category weight if the human substantively performed the category; otherwise award 0. Never assign partial credit.",
  "grade_rule": {
    "base":"floor(total/10)",
    "plus":"total % 10 >= 5",
    "canonical":"ILCX {base}H{plus} grade",
    "score_100":"ILCX 10H grade"
  }
}
